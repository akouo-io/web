{
  "name": "akouo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm -r --parallel lint",
    "typecheck": "pnpm -r --parallel typecheck",
    "dev:app": "pnpm --filter @akouo/app dev",
    "dev:desktop": "pnpm --filter @akouo/desktop dev",
    "dev:website": "pnpm --filter @akouo/website dev",
    "build:app": "pnpm --filter @akouo/app build",
    "build:desktop": "pnpm --filter @akouo/desktop build",
    "build:website": "pnpm --filter @akouo/website build"
  },
  "devDependencies": {
    "@akouo/eslint-config": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.7.3"
  }
}
